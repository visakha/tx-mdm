# Copy to .env and fill in. .env is git-ignored. Never commit the real password.
IDMC_USERNAME=your-idmc-username
IDMC_PASSWORD=change-me

# Where the v3 login call goes (POST {IDMC_LOGIN_URL}/saas/public/core/v3/login).
IDMC_LOGIN_URL=https://dm1-us.informaticacloud.com

# Business 360 (MDM) API host. Ingress / Egress / MatchMerge and job instances live here.
IDMC_MDM_URL=https://usw1-mdm.dm1-us.informaticacloud.com

# Optional. Leave empty to use products[].baseApiUrl returned by the v3 login
# (expected: https://usw1.dm1-us.informaticacloud.com/saas).
IDMC_PLATFORM_URL=

# Seconds an MDM job-definition resolution stays cached.
MDM_RESOLVER_CACHE_SECONDS=600

# Frontend origin allowed by CORS (only needed if you do not use the Vite proxy).
FRONTEND_ORIGIN=http://localhost:5173

# Outbound proxy for IDMC calls (e.g. http://proxy.corp:8080). Empty = direct connection.
IDMC_PROXY_URL=
# true = also honour HTTP(S)_PROXY / NO_PROXY env vars. Default false: a malformed NO_PROXY
# (e.g. an IPv6 entry like [::1]) makes httpx raise InvalidURL on every call. If env vars
# cannot be parsed, the backend logs a warning and falls back to IDMC_PROXY_URL.
HTTP_TRUST_ENV=false
